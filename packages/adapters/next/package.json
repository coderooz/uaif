{
  "name": "@uaif/adapter-next",
  "version": "0.1.0",
  "description": "UAIF Next.js Adapter — Next.js-specific integration adapter",
  "author": "Coderooz <contact@coderooz.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderooz/uaif.git",
    "directory": "packages/adapters/next"
  },
  "homepage": "https://github.com/coderooz/uaif#readme",
  "bugs": {
    "url": "https://github.com/coderooz/uaif/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@uaif/core": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
