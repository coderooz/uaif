{
  "name": "@uaif/adapter-cloudinary",
  "version": "0.1.0",
  "description": "UAIF adapter for Cloudinary storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "cloudinary": "^2.0.0",
    "@uaif/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Coderooz",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderooz/uiaf.git",
    "directory": "packages/adapters/cloudinary"
  },
  "homepage": "https://github.com/coderooz/uiaf#readme",
  "bugs": {
    "url": "https://github.com/coderooz/uiaf/issues"
  }
}
