{
  "name": "@uaif/adapter-firebase-auth",
  "version": "0.1.0",
  "description": "UAIF adapter for Firebase Authentication",
  "author": "Coderooz <contact@coderooz.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderooz/uaif.git",
    "directory": "packages/adapters/firebase-auth"
  },
  "homepage": "https://coderooz.github.io/uaif/",
  "bugs": {
    "url": "https://github.com/coderooz/uaif/issues"
  },
  "keywords": [
    "uaif",
    "adapter",
    "firebase",
    "authentication",
    "auth",
    "integration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "@uaif/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
