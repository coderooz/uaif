{
  "name": "@uaif/adapter-mongodb",
  "version": "0.1.0",
  "description": "UAIF adapter for MongoDB database",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "mongodb": "^6.0.0",
    "@uaif/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Coderooz",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderooz/uaif.git",
    "directory": "packages/adapters/mongodb"
  },
  "homepage": "https://github.com/coderooz/uaif#readme",
  "bugs": {
    "url": "https://github.com/coderooz/uaif/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
