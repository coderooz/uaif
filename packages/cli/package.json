{
  "name": "@uiaf/cli",
  "version": "0.1.0",
  "description": "UIAF CLI — Command-line interface for managing integrations",
  "author": "Coderooz <contact@coderooz.in>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uai": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "uai": "node dist/cli.js"
  },
  "dependencies": {
    "@uiaf/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
